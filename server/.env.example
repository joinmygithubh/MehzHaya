# ===== Server =====
PORT=5000
NODE_ENV=production
CLIENT_URL=https://your-app.netlify.app

# ===== Database =====
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/mehzhaya?retryWrites=true&w=majority

# ===== JWT Authentication =====
JWT_SECRET=your_production_super_secret_jwt_key_at_least_32_chars
REFRESH_TOKEN_SECRET=your_production_super_secret_refresh_key_at_least_32_chars
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# ===== Google OAuth 2.0 (Optional) =====
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ===== Cloudinary (Image Storage) =====
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ===== Nodemailer (SMTP Email) =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM_NAME=MehzHaya
EMAIL_FROM=no-reply@mehzhaya.com

# ===== Razorpay (Payments) =====
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ===== Seed Admin Credentials =====
ADMIN_NAME=MehzHaya Admin
ADMIN_EMAIL=admin@mehzhaya.com
ADMIN_PASSWORD=AdminPassword123!
