# ===== Server =====
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ===== Database =====
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/mehzhaya?retryWrites=true&w=majority

# ===== JWT =====
JWT_SECRET=your_super_secret_jwt_key_change_me
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# ===== Cloudinary (image storage) =====
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===== Nodemailer (SMTP) =====
# For development you can use Mailtrap / Ethereal / Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM_NAME=MehzHaya
EMAIL_FROM=no-reply@mehzhaya.com

# ===== Razorpay (Test Mode) =====
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_test_secret

# ===== Seed admin =====
ADMIN_NAME=MehzHaya Admin
ADMIN_EMAIL=admin@mehzhaya.com
ADMIN_PASSWORD=Admin@12345
